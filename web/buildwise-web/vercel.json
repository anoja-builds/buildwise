{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_API_BASE_URL": {
      "description": "BuildWise API base URL (e.g. https://buildwise-api.railway.app/api)",
      "required": true
    }
  }
}
