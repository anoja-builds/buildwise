# PostgreSQL and ASP.NET Core
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=buildwise
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-postgres-password

# Optional. scripts/start-dev.ps1 builds ConnectionStrings__DefaultConnection from the values above.
# ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=buildwise;Username=postgres;Password=replace-me

# Use a random value of at least 32 characters. Never reuse this example in production.
Jwt__Key=replace-with-a-random-secret-at-least-32-characters-long
Jwt__Issuer=BuildWise
Jwt__Audience=BuildWiseClients

# Clients
VITE_API_BASE_URL=http://localhost:5078/api
# Flutter is configured at build/run time:
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:5078/api

# Internal AI services
AgentService__Url=http://127.0.0.1:8001
AgentService__RequestUrl=http://127.0.0.1:8002/
AgentService__DeliveryUrl=http://127.0.0.1:8003/
AgentService__QualityUrl=http://127.0.0.1:8004/

# Optional external LLM explanations. Leave blank to use deterministic/safe-fallback mode.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_TIMEOUT_S=8
